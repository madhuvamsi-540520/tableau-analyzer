              <groupfilter function='member' level='[Sub Category Group]' member='&quot;Machines&quot;' />
              <groupfilter function='member' level='[Sub Category Group]' member='&quot;Paper&quot;' />
              <groupfilter function='member' level='[Sub Category Group]' member='&quot;Phones&quot;' />
              <groupfilter function='member' level='[Sub Category Group]' member='&quot;Storage&quot;' />
